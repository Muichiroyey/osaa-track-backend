# ─────────────────────────────────────────────────────────────
# OSAA-TRACK Admin Panel — Backend Environment Variables
# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Several front-end origins can be listed, separated by commas, when hosted separately:
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Auth
# AUTH_SECRET is used to sign/verify admin session tokens. Generate a long
# random string for real deployments, e.g. `openssl rand -hex 32`.
AUTH_SECRET=replace-this-with-a-long-random-string
# How long an admin session stays valid without activity (hours)
SESSION_TTL_HOURS=12

# ─────────────────────────────────────────────────────────────
# DATABASE — MySQL. Import database/schema.sql before first run.
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=osaa_track
DB_USER=root
DB_PASSWORD=root
# Optional — how many database connections the API may use at once (default 25).
# Raise it if many people are signed in and pages feel slow; keep it below MySQL's max_connections.
# DB_POOL_SIZE=25

# ─────────────────────────────────────────────────────────────
# EMAIL — announcement notifications (optional)
# ─────────────────────────────────────────────────────────────
# When these are filled in, publishing an announcement emails everyone in
# its target audience (students/alumni/offices) who has an email on file.
# Leave EMAIL_ENABLED=false to skip email entirely — the app works fine
# without it; publishing just won't send anything, and the server log
# will say so.
#
# Any standard SMTP provider works — Gmail (with an App Password, not
# your normal password), Outlook/Office 365, or a transactional service
# like Resend, SendGrid, Mailgun, or Postmark. See the README's
# "Announcement emails" section for exact steps.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=OSAA-TRACK <no-reply@example.com>
